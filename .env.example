# Copy to .env and fill in. .env is git-ignored, so personal details stay out of the repo.

# Heading shown at the top of the page
APP_TITLE="Homework & bedtime routine"
# Browser tab / home-screen app name
APP_SHORT_NAME="Night Routine"
# Port on the host (NAS) that serves the app
HOST_PORT=8080
# Docker container name
CONTAINER_NAME=night-routine
